# Proveedores (claves de factories).
#   LLM_PROVIDER / EMBEDDING_PROVIDER: openai | mock
#   "mock" = modo demo 100% offline, sin ninguna API Key.
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
VECTOR_STORE_PROVIDER=chroma

# OpenAI — o cualquier endpoint compatible con su API vía OPENAI_BASE_URL:
#   Ollama (local, sin API Key real):
#     OPENAI_BASE_URL=http://localhost:11434/v1
#     OPENAI_API_KEY=ollama
#     OPENAI_MODEL=llama3.1          EMBEDDING_MODEL=nomic-embed-text
#   Gemini (endpoint de compatibilidad OpenAI de Google):
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     OPENAI_API_KEY=<GEMINI_API_KEY>
#     OPENAI_MODEL=gemini-2.5-flash  EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Documentos y datos
DOCUMENTS_PATH=documents/
AFFILIATES_FILE=data/BD_afiliados.xlsx

# Vector Store
VECTOR_DB_PATH=storage/chroma
TOP_K_RESULTS=5
MIN_SIMILARITY_SCORE=0.25

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# API
HOST=0.0.0.0
PORT=8000
DEBUG=False
REINDEX_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/application.log
